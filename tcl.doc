} elseif {$parameter == "MFT"} {
set a [lindex $line 2]
} elseif {$parameter == "MIRT"} {
set a [lindex $line 3]
} elseif {$parameter == "MIFT"} {
set a [lindex $line 4]
} elseif {$parameter == "scenario"} {
set a [lindex $line 5]
} else {
puts "Error: wrong parameter"
}
}
}
puts "the cell name is $cell_name and parameter is $parameter : $a"

	


