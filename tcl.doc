if {$a % 4 == 0 && $a % 6 ==0} {
puts $a
}
}


example5: write a tcl prm to print all the prime numbers from 2 to 100.

for {set i 2} {$i <= 100} {incr i} {
set isprime 1
for {set a 2} {$a < $i} {incr a} {
	if {$i % $a == 0} {
	set isprime 0
	break
	}
}
if {$isprime} {
puts $i
}
}


