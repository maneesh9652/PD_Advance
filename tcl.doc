example2:
Read the macro_area file and display all the lines and calculate the area of each cell and total area of the cell using file handling operations.
(note: if coordinates are not givenm on order,if check the arguments value, if arguments are not sufficient print error., x1>x2 and y1>y2, orint the error.)

set file [open "macro_area" r]
set file1 [open "output.txt" w] 
set total_area 0
while {[gets $file line] >= 0} {
#puts $line
set length [llength $line]
if {$length == 0} {
continue
}
for {set i 1} {$i < $length} {incr i 2} {
switch [lindex $line $i] {
"x1" {set x1 [lindex $line $i+1]}
"x2" {set x2 [lindex $line $i+1]}
"y1" {set y1 [lindex $line $i+1]}
"y2" {set y2 [lindex $line $i+1]}
}
}
set area [expr  ($x2-$x1)*($y2-$y1)]
puts "Area of the [lindex $line 0] is : $area"
puts $file1 "Area of the [lindex $line 0] is : $area"
set total_area [expr $total_area + $area]
#puts "Total area of the all cells is: $total_area"
}
puts "Total area of the all cells is: $total_area"


