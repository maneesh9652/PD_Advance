	if {$a / 10 == 7} {
continue	
}
puts $a
}
}


example 11:write tcl pgm to print all the num from 1 to 100 which is divisble by 4 and skip when its in 60's and stops when its in 90's.

for {set a 1} {$a <= 100} {incr a 1} {
if {$a % 4 == 0 } {
	if {$a / 10 == 6} {
continue	
}
if {$a / 10 == 9} {
break
}
puts $a
}
}

