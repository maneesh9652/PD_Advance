set c [expr $x1 + $x2]
#puts "hello world"
return $c
puts "hello world"

}
puts [add 100 500]

5. write a proc for addition, sub, mul, div of two numbers.

note:
x1 ==0 and x2 =0 ---> addition
x1 ==0 and x2 =1 ---> sub
x1 ==1 and x2 =0 ---> mul
x1 ==1 and x2 =1 ----> div

solution:
proc arith {x1 x2 a b} {
if {$x1 == 0 && $x2 ==0} {
set c [expr $a + $b]
return $c
} elseif {$x1 == 0 && $x2 ==1} {
set c [expr $a - $b]
return $c
} elseif {$x1 == 1 && $x2 ==0} {
set c [expr $a * $b]
return $c
} elseif {$x1 == 1 && $x2 ==1} {
set c [expr $a / $b]
return $c
} else {
puts "error"
}
}
puts "addition of 2 num is:[ arith 0 0 10 20]"
puts "sub of 2 num is:[ arith 0 1 10 20]"
puts "mul of 2 num is:[ arith 1 0 10 20]"
puts "div of 2 num is:[ arith 1 1 100 20]"



6. write a tcl prg to print factorial of the number using proc?

proc fac {a} {
set b 1
for {set i 1} {$i <= $a} {incr i} {
set b [expr $i*$b]
}
return $b
}
puts [fac 5]

