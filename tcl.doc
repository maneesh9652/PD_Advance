9. wtrite a tcl pgm to find the area of a cell, pass the file and cell name  as argument value using proc.
proc area {file_name parameter} {
set file [open "$file_name" r]  
set flag 0
while {[gets $file line] >= 0} {
set length [llength $line]
if {$length == 0} {
continue
}
set para [lindex $line 0]
if {$parameter == $para } {
for {set i 1} {$i < $length} {incr i 2} {
switch [lindex $line $i] {
"x1" {set x1 [lindex $line $i+1]}
"x2" {set x2 [lindex $line $i+1]}
"y1" {set y1 [lindex $line $i+1]}
"y2" {set y2 [lindex $line $i+1]}
}
}
set area [expr ($x2 -$x1) * ($y2-$y1)]
puts "area of the [lindex $line 0] is : $area"
exit
}
}
if {$flag == 0} {
puts "error: wrong cell name"
}
}

area macro_area SRAM


11. find the number of times 0.10 present in the cell_info.txt file using proc.
proc count {file_name} {
set file [open "$file_name" r]
set num 0
while {[gets $file line] >= 0} {
foreach b $line {
if {$b == 0.10} {
incr num
}
}
}
puts "the number of times 0.10 present in the file is : $num"
}
